{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "//": "Vercel'da FAQAT Mini App (frontend) joylashtiriladi. Bot + API alohida serverda turadi — README ga qarang.",
  "installCommand": "npm install --workspace @testrace/web --workspace @testrace/shared --include-workspace-root",
  "buildCommand": "npm run build -w @testrace/web",
  "outputDirectory": "packages/web/dist",
  "framework": null,
  "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
