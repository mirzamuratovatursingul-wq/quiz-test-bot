# ---- Telegram ----
BOT_TOKEN=123456:ABC-DEF_bot_tokeningiz
BOT_USERNAME=testrace_bot   # @ belgisiz ham, @ bilan ham boladi

# ---- Mini App ----
# Telegram web_app tugmalari faqat HTTPS bilan ishlaydi.
# Eng oson yoli: "npm run tunnel" — HTTPS manzil ochib, quyidagi qatorni ozi yangilaydi.
WEBAPP_URL=https://xxxx.trycloudflare.com

# ---- Ma'lumotlar bazasi ----
MONGODB_URI=mongodb://127.0.0.1:27017/testrace

# ---- Server ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SERVE_WEB=true
MAX_FILE_MB=20
INITDATA_TTL=86400

# Vergul bilan ajratilgan admin Telegram ID lar
ADMIN_IDS=

# Faqat ishlab chiqish uchun: Telegramsiz brauzerda test qilish
# DEV_USER_ID=123456789
